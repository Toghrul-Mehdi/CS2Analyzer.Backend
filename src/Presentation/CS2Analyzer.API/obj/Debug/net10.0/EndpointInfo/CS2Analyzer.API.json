    },
    "/api/Stats/user/{steamId}": {
      "get": {
        "tags": [
          "Stats"
        ],
        "parameters": [
          {
            "name": "steamId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerStatsDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerStatsDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerStatsDto"
                }
              }
            }
          }
        }
      }
    }
